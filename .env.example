# برای اجرای محلی: این فایل را کپی کنید، مقادیر را پر کنید و با `set -a; source .env; set +a` بارگذاری کنید.
TELEGRAM_BOT_TOKEN=123456:ABC-توکن-از-BotFather
YOUTUBE_API_KEY=کلید-YouTube-Data-API
# شناسهٔ عددی تلگرام شما (چند نفر را با ویرگول جدا کنید). اگر نمی‌دانید، ربات را اجرا کنید و /start بزنید؛ شناسه را نشان می‌دهد.
ALLOWED_USER_IDS=123456789

# برای دکمهٔ «💡 ایده‌های ویدیو» (کلید API از console.anthropic.com؛ اگر خالی باشد دکمه نمایش داده نمی‌شود)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# اختیاری
# MAX_KEYWORDS=6
# TOP_N=10
# CACHE_TTL_SECONDS=21600
